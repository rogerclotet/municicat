# Read by drizzle-kit and the standalone scripts (migrate, seed), which run on
# the host rather than inside the app container. Matches the `db` service
# published port below, whether it's compose.dev.yml or compose.yaml.
DATABASE_URL=postgres://municicat:municicat@localhost:55432/municicat

# Used by compose.yaml (production). The app container talks to `db` directly
# and builds its own DATABASE_URL from these instead of reading the one above.
APP_PORT=3000
PG_PORT=55432
POSTGRES_DB=municicat
POSTGRES_USER=municicat
POSTGRES_PASSWORD=municicat
